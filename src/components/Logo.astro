---
// The Overfit mark: a hand-drawn scatter with a squiggly curve threading
// through every single point — the picture of a model that memorized the
// noise instead of the trend. The faint dashed line is the signal it should
// have learned; the teal dot is the outlier it detoured to chase. Colors
// come from CSS tokens, so it follows light/dark. Animates in on load;
// gently "resamples" on hover (see styles below).
interface Props {
  height?: number;
  class?: string;
}
const { height = 34, class: className = '' } = Astro.props;
const width = Math.round((height * 68) / 48);
---

<svg
  class:list={['of-logo', className]}
  width={width}
  height={height}
  viewBox="0 0 68 48"
  fill="none"
  role="img"
  aria-label="The Overfit logo — a wiggly curve chasing every point in a scatter"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- the signal it should have learned -->
  <path class="of-true" d="M8 37 L60 13" stroke="var(--ink-soft)" stroke-width="2" stroke-dasharray="4 4" />

  <!-- the overfit curve, drawn twice with a tiny offset for a sketchy feel -->
  <path
    class="of-curve"
    d="M8 39 C 10 31 11 33 13 33 C 16 41 19 24 22 30 C 25 36 27 25 30 31 C 33 39 36 13 38 19 C 41 26 45 31 47 25 C 50 18 54 10 56 13 C 58 16 59 14 60 12"
    stroke="var(--accent)"
    stroke-width="3"
  />
  <path
    class="of-curve2"
    d="M8.6 39.4 C 10.6 31.5 11.6 33.4 13.4 33.4 C 16.3 40.4 19.3 24.6 22.3 30.4 C 25.2 35.6 27.3 25.6 30.4 31.3 C 33.3 38.4 36.3 13.8 38.4 19.4 C 41.2 26.3 45.3 31.3 47.3 25.4 C 50.2 18.6 54.2 10.7 56.3 13.4 C 58 16 59 14.4 60.4 12.4"
    stroke="var(--ink)"
    stroke-width="1.5"
  />

  <!-- the scattered points the model memorized -->
  <g class="of-dots" stroke="var(--ink)" stroke-width="1.6">
    <circle cx="13" cy="33" r="2.3" fill="var(--bg)" />
    <circle cx="22" cy="30" r="2.3" fill="var(--bg)" />
    <circle cx="30" cy="31" r="2.3" fill="var(--bg)" />
    <circle cx="38" cy="19" r="2.3" fill="var(--bg)" />
    <circle cx="56" cy="13" r="2.3" fill="var(--bg)" />
  </g>

  <!-- the outlier it chased -->
  <circle class="of-dot" cx="47" cy="25" r="3.6" fill="var(--accent2)" stroke="var(--bg)" stroke-width="1.3" />
</svg>

<style>
  /* ---- entrance (plays once on load) ---- */
  .of-true {
    stroke-dasharray: 4 4;
    opacity: 0;
    animation: of-fade 0.5s ease 0.1s forwards;
  }
  .of-curve {
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    animation: of-draw 1s ease forwards;
  }
  .of-curve2 {
    opacity: 0;
    animation: of-fade2 0.5s ease 0.6s forwards;
  }
  .of-dots circle {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    animation: of-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .of-dots circle:nth-child(1) { animation-delay: 0.45s; }
  .of-dots circle:nth-child(2) { animation-delay: 0.55s; }
  .of-dots circle:nth-child(3) { animation-delay: 0.65s; }
  .of-dots circle:nth-child(4) { animation-delay: 0.75s; }
  .of-dots circle:nth-child(5) { animation-delay: 0.85s; }
  .of-dot {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    animation: of-pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) 0.95s both;
  }

  @keyframes of-draw { to { stroke-dashoffset: 0; } }
  @keyframes of-fade { to { opacity: 0.7; } }
  @keyframes of-fade2 { to { opacity: 0.55; } }
  @keyframes of-pop { to { transform: scale(1); } }

  /* ---- hover: the curve "resamples" ---- */
  :global(.brand):hover .of-dot,
  .of-logo:hover .of-dot {
    animation: of-bob 1.4s ease-in-out infinite;
  }
  :global(.brand):hover .of-curve,
  .of-logo:hover .of-curve {
    animation: of-jitter 1.1s ease-in-out infinite;
  }

  @keyframes of-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2.5px); }
  }
  @keyframes of-jitter {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .of-true { opacity: 0.7; animation: none; }
    .of-curve { stroke-dashoffset: 0; animation: none; }
    .of-curve2 { opacity: 0.55; animation: none; }
    .of-dots circle { transform: scale(1); animation: none; }
    .of-dot { transform: scale(1); animation: none; }
  }
</style>
