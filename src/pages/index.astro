---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, slugifyTag } from '../utils/tags';

const posts = await getPublishedPosts();
const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="The Overfit">
  <div class="eyebrow">ML Explainers <span class="dot">·</span> for people who want the intuition</div>
  <h1>The hard parts of machine&nbsp;learning, drawn by hand.</h1>
  <p class="lede">
    Every post takes one intimidating idea and breaks it down with sketches, rolling balls,
    and as little jargon as it can get away with.
  </p>

  {posts.length === 0 ? (
    <p class="byline">No posts yet — the first explainer is on its way.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-card" data-sketch-frame>
          <a class="card-title" href={`/posts/${post.id}`}>{post.data.title}</a>
          <div class="meta">{fmt(post.data.pubDate)}</div>
          <p>{post.data.description}</p>
          <div>
            {post.data.tags.map((t) => (
              <a class="tag tag-link" href={`/tags/${slugifyTag(t)}/`}>#{t}</a>
            ))}
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
