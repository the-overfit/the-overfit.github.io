---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/tags';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Browse The Overfit by topic.">
  <a class="back-link" href="/">← home</a>
  <h1 style="margin-top:14px;">Browse by tag</h1>
  <p class="lede">Everything on the blog, sorted by what it's about.</p>

  {tags.length === 0 ? (
    <p class="byline">No tags yet.</p>
  ) : (
    <ul class="tag-cloud">
      {tags.map((t) => (
        <li>
          <a class="tag tag-link" href={`/tags/${t.slug}/`}>
            #{t.label} <span class="count">{t.posts.length}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
