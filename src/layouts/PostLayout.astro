---
import BaseLayout from './BaseLayout.astro';
import { slugifyTag } from '../utils/tags';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    tags?: string[];
    ogImage?: string;
  };
}
const { frontmatter } = Astro.props;
const date = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} image={frontmatter.ogImage} type="article">
  <article data-pagefind-body>
    <a class="back-link" href="/" data-pagefind-ignore>← all explainers</a>
    <div class="eyebrow" style="margin-top:14px;">
      ML Explainers <span class="dot">·</span> breaking down the hard stuff
    </div>
    <h1>{frontmatter.title}</h1>
    <p class="byline">{date}</p>
    {frontmatter.tags?.length ? (
      <div class="post-tags">
        {frontmatter.tags.map((t) => (
          <a class="tag tag-link" href={`/tags/${slugifyTag(t)}/`}>#{t}</a>
        ))}
      </div>
    ) : null}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
