---
import BaseLayout from './BaseLayout.astro';
import { slugifyTag } from '../utils/tags';
import ClapButton from '../components/ClapButton.tsx';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    tags?: string[];
  };
  postId: string;
}
const { frontmatter, postId } = Astro.props;
const date = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article>
    <a class="back-link" href="/">← all explainers</a>
    <div class="eyebrow" style="margin-top:14px;">
      ML Explainers <span class="dot">·</span> breaking down the hard stuff
    </div>
    <h1>{frontmatter.title}</h1>
    <p class="byline">{date}</p>
    {frontmatter.tags?.length ? (
      <div class="post-tags">
        {frontmatter.tags.map((t) => (
          <a class="tag tag-link" href={`/tags/${slugifyTag(t)}/`}>#{t}</a>
        ))}
      </div>
    ) : null}
    <div class="prose">
      <slot />
    </div>
    <ClapButton client:visible postId={postId} />
  </article>
</BaseLayout>
